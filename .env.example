# =============================================
# AI Knowledge Base - Environment Configuration
# =============================================

# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://akb:akb_password@localhost:5432/ai_knowledge_base

# Authentication
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# AI / LLM (BYOK：用户自带 Key，在前端"设置"页配置，加密存库。这里不设全局 key)
# Encryption key for users' LLM API keys stored in DB (any random string).
# NOTE: 不是 OpenAI key，仅供应用加解密用户填写的 key。
LLM_CONFIG_ENCRYPTION_KEY=change-me-to-a-random-encryption-passphrase

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
